+ drout=0.45 pvag=1e-20 delta=0.01 pscbe1=8.14e+8
+ pscbe2=1e-7 fprout=0.0 pdits=0.0 pditsd=0.0
+ pditsl=0.0 rsh=0.0 rdsw=150 rsw=150 rdw=150
+ rdswmin=0 rdwmin=0 rswmin=0 prwb=0.0 prwg=0.0
+ wr=1.0 alpha0=0.074 alpha1=0.005 beta0=30.0
+ agidl=0.0002 bgidl=2.1e9 cgidl=0.0002 egidl=0.8
+ aigbacc=0.012 bigbacc=0.0028 cigbacc=0.002
+ nigbacc=1.0 aigbinv=0.014 bigbinv=0.004 cigbinv=0.004
+ eigbinv=1.1 nigbinv=3.0 aigc=0.012 bigc=0.0028
+ cigc=0.002 aigsd=0.012 bigsd=0.0028 cigsd=0.002
